#!/bin/bash
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx
ynh_config_add_systemd
yunohost service add "$app" --log="$install_dir/DATA/LOG/yacy00.log"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Configuring $app..."

# Start temporarily to run initial password configuration
ynh_systemctl --service="$app" --action="start" \
    --log_path="$install_dir/DATA/LOG/yacy00.log" \
    --wait_until="Started httpd:"

ynh_exec_as_app YACY_DATA_PATH="$install_dir/DATA" \
    "$install_dir/bin/passwd.sh" "$password"

ynh_systemctl --service="$app" --action="stop" \
    --log_path="$install_dir/DATA/LOG/yacy00.log"

ynh_replace \
    --file="$install_dir/DATA/SETTINGS/yacy.conf" \
    --match="promoteSearchPageGreeting.homepage=https://yacy.net" \
    --replace="promoteSearchPageGreeting.homepage=https://$domain$path"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

timeout 300 bash -c \
    'until curl -sf http://localhost:8090/ > /dev/null 2>&1; do sleep 5; done' \
    || ynh_die "YaCy HTTP server did not become ready within 300 seconds"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
