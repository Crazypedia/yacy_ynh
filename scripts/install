#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

# The tarball ships an empty DATA folder: YaCy's data lives in $data_dir instead
ynh_safe_rm "$install_dir/DATA"

chown -R "$app:www-data" "$install_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Configuring $app..."

# Seed the configuration from YaCy's defaults, exactly as YaCy does on first
# start, so it can be adjusted before the server ever runs.
mkdir -p "$data_dir/DATA/SETTINGS" "$data_dir/DATA/LOG"
cp "$install_dir/defaults/yacy.init" "$data_dir/DATA/SETTINGS/yacy.conf"
_yacy_apply_ynh_settings

chmod 750 "$data_dir"
chown -R "$app:$app" "$data_dir"

# Set the administrator password while YaCy is stopped (writes the hash to yacy.conf)
ynh_exec_as_app env YACY_DATA_PATH="$data_dir/DATA" "$install_dir/bin/passwd.sh" "$password"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd
yunohost service add "$app" --description="YaCy search engine" --log="$data_dir/DATA/LOG/yacy00.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

_yacy_start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
